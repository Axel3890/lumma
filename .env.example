RESEND_API_KEY=
# Remitente de un dominio verificado en Resend. Ejemplo: Cursiva <avisos@tudominio.com>
REMINDER_FROM=
# Activar solo después de aplicar la migración y configurar el remitente.
REMINDERS_ENABLED=false
# Origen HTTPS donde se aloja el backend. Requerido para suscripciones Google Calendar.
PUBLIC_API_URL=
# En un hosting Node normalmente debe ser 0.0.0.0; en desarrollo 127.0.0.1.
HOST=127.0.0.1
